{
  "description": "Check Codex sessions in and out of Repo Lines.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.repo-lines/app/bin/repo-lines.js session start --agent Codex --pid none --quiet",
            "commandWindows": "node \"C:\\Users\\saulg\\.repo-lines\\app\\bin\\repo-lines.js\" session start --agent Codex --pid none --quiet",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.repo-lines/app/bin/repo-lines.js session beat --agent Codex --pid none --quiet",
            "commandWindows": "node \"C:\\Users\\saulg\\.repo-lines\\app\\bin\\repo-lines.js\" session beat --agent Codex --pid none --quiet",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.repo-lines/app/bin/repo-lines.js session end --quiet",
            "commandWindows": "node \"C:\\Users\\saulg\\.repo-lines\\app\\bin\\repo-lines.js\" session end --quiet",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
